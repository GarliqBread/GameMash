---
type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<span
  class:list={[
    "inline-block rounded-sticker border-2 border-ink-950 px-2.5 py-1 font-pixel text-xs font-bold tracking-pixel text-ink-950 shadow-brutal-sm sm:text-sm",
    className,
  ]}
>
  <slot />
</span>
