{
  "name": "@gamemash/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@gamemash/games": "workspace:*",
    "@gamemash/shared": "workspace:*",
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "pino": "^10.3.1",
    "proxy-addr": "^2.0.8",
    "redis": "^6.2.1",
    "socket.io": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@types/proxy-addr": "^2.0.3",
    "socket.io-client": "catalog:",
    "tsx": "^4.23.15",
    "vitest": "catalog:"
  }
}
