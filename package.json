{
  "name": "gamemash",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:packages": "tsc -b packages/shared packages/messages",
    "dev": "pnpm build:packages && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm build:packages && pnpm -r test",
    "redis": "docker compose up -d --wait redis"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
