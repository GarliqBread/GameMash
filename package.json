{
  "name": "gamemash",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:packages": "tsc -b packages/shared packages/messages packages/ui packages/games",
    "dev": "pnpm build:packages && pnpm run \"/^dev:/\"",
    "dev:packages": "tsc -b --watch --preserveWatchOutput packages/shared packages/messages packages/ui packages/games",
    "dev:apps": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm build:packages && pnpm -r test",
    "services": "docker compose up -d --wait redis minio && docker compose run --rm minio-setup",
    "stories": "pnpm --filter @gamemash/ui stories"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
