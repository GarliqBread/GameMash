{
  "name": "@gamemash/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css",
    "./fonts.css": "./src/fonts.css"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.stories.json",
    "stories": "ladle serve",
    "stories:build": "ladle build",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@gamemash/shared": "workspace:*",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bold": "^3.31.3",
    "@tiptap/extension-document": "^3.31.3",
    "@tiptap/extension-italic": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-text": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-contour": "^4.0.2",
    "lucide-react": "^1.49.0",
    "perfect-freehand": "^1.2.3",
    "simplify-js": "^1.2.4",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@tailwindcss/vite": "catalog:",
    "@types/d3-contour": "^3.0.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
